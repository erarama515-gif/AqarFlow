// =============================================================================
// AqarFlow — Prisma Schema
// Modular monolith with tenant-aware multi-tenancy + soft delete + audit fields
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, unaccent, btree_gin]
}

// =============================================================================
// IAM & TENANT
// =============================================================================

enum TenantStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum PlanCode {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum CountryCode {
  SA  // Saudi Arabia
  AE  // United Arab Emirates
  EG  // Egypt
  KW
  QA
  BH
  OM
  JO
  MA
  IQ
  LB
}

model Tenant {
  id            String       @id @default(uuid()) @db.Uuid
  subdomain     String       @unique
  customDomain  String?      @unique @map("custom_domain")
  name          String
  legalName     String?      @map("legal_name")
  country       CountryCode
  currency      String       @db.Char(3) // ISO 4217 (SAR, AED, EGP, USD)
  locale        String       @default("ar-SA")
  timezone      String       @default("Asia/Riyadh")
  planCode      PlanCode     @default(FREE) @map("plan_code")
  status        TenantStatus @default(TRIALING)
  trialEndsAt   DateTime?    @map("trial_ends_at")
  ownerId       String?      @map("owner_id") @db.Uuid
  brandingLogo  String?      @map("branding_logo")
  brandingColor String?      @map("branding_color")
  hijriEnabled  Boolean      @default(true) @map("hijri_enabled")
  metadata      Json?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  users               User[]
  branches            Branch[]
  roles               Role[]
  leads               Lead[]
  contacts            Contact[]
  accounts            Account[]
  properties          Property[]
  masterProjects      MasterProject[]
  buildings           Building[]
  floors              Floor[]
  deals               Deal[]
  pipelines           Pipeline[]
  activities          Activity[]
  viewings            Viewing[]
  tasks               Task[]
  commissionRules     CommissionRule[]
  commissionEntries   CommissionEntry[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  leadSources         LeadSource[]
  distributionRules   DistributionRule[]
  emailTemplates      EmailTemplate[]
  outboxEvents        OutboxEvent[]
  attachments         Attachment[]
  reservations        Reservation[]
  paymentPlans        PaymentPlan[]
  documents           Document[]
  notes               Note[]
  bookings            Booking[]
  chartOfAccounts    ChartOfAccount[]
  journalEntries     JournalEntry[]
  receipts           Receipt[]

  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

model Branch {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  name      String
  code      String
  country   CountryCode
  city      String?
  address   String?
  phone     String?
  email     String?
  timezone  String?
  isDefault Boolean     @default(false) @map("is_default")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users   UserBranch[]
  leads   Lead[]
  deals   Deal[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  tenantId             String     @map("tenant_id") @db.Uuid
  email                String
  emailVerifiedAt      DateTime?  @map("email_verified_at")
  phone                String?
  phoneVerifiedAt      DateTime?  @map("phone_verified_at")
  passwordHash         String?    @map("password_hash") // null when only social login
  firstName            String     @map("first_name")
  lastName             String     @map("last_name")
  fullNameAr           String?    @map("full_name_ar")
  avatarUrl            String?    @map("avatar_url")
  locale               String?
  timezone             String?
  status               UserStatus @default(PENDING)
  mfaEnabled           Boolean    @default(false) @map("mfa_enabled")
  mfaSecret            String?    @map("mfa_secret") // encrypted
  lastLoginAt          DateTime?  @map("last_login_at")
  lastLoginIp          String?    @map("last_login_ip")
  failedLoginAttempts  Int        @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?  @map("locked_until")
  preferences          Json?
  metadata             Json?
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  deletedAt            DateTime?  @map("deleted_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles             UserRole[]
  branches          UserBranch[]
  identities        UserIdentity[]
  refreshTokens     RefreshToken[]
  assignedLeads     Lead[]             @relation("LeadAssignee")
  ownedDeals        Deal[]             @relation("DealOwner")
  activities        Activity[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  commissionEntries CommissionEntry[]  @relation("CommissionRecipient")
  notes             Note[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([email])
  @@map("users")
}

model UserIdentity {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  provider    String // google, apple, password, uae-pass, nafath
  externalId  String   @map("external_id")
  accessToken String?  @map("access_token") @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId])
  @@map("user_identities")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid // null = system role
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isDefault   Boolean  @default(false) @map("is_default")
  permissions String[] // permission strings like 'lead:create', 'deal:read'
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

model UserRole {
  userId   String   @map("user_id") @db.Uuid
  roleId   String   @map("role_id") @db.Uuid
  branchId String?  @map("branch_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserBranch {
  userId   String   @map("user_id") @db.Uuid
  branchId String   @map("branch_id") @db.Uuid
  isPrimary Boolean @default(false) @map("is_primary")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

// =============================================================================
// LEAD MANAGEMENT
// =============================================================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VIEWING_SCHEDULED
  OFFER_SENT
  NEGOTIATION
  WON
  LOST
  UNREACHABLE
  JUNK
}

enum LeadChannel {
  WEB_FORM
  WHATSAPP
  EMAIL
  PHONE
  WALK_IN
  PORTAL
  META_AD
  GOOGLE_AD
  TIKTOK_AD
  REFERRAL
  IMPORT
  API
  MANUAL
  OTHER
}

enum InterestType {
  BUY
  RENT
  INVEST
  SELL
  RENT_OUT
}

model LeadSource {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  name        String
  channel     LeadChannel
  webhookKey  String?  @unique @map("webhook_key")
  isActive    Boolean  @default(true) @map("is_active")
  costPerLead Decimal? @map("cost_per_lead") @db.Decimal(19, 4)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, code])
  @@map("lead_sources")
}

model DistributionRule {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  priority    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  conditions  Json     // JSONLogic-style conditions
  strategy    String   // round_robin, weighted, skill_based, manual
  assigneeIds String[] @map("assignee_ids") // candidate users
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("distribution_rules")
}

model Lead {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  branchId        String?      @map("branch_id") @db.Uuid
  sourceId        String?      @map("source_id") @db.Uuid
  contactId       String?      @map("contact_id") @db.Uuid

  // Identity (denormalized for fast dedup)
  fullName        String       @map("full_name")
  phone           String?
  phoneNormalized String?      @map("phone_normalized") // E.164
  email           String?
  emailLower      String?      @map("email_lower")
  nationalId      String?      @map("national_id")

  // Lifecycle
  status          LeadStatus   @default(NEW)
  channel         LeadChannel
  assignedToId    String?      @map("assigned_to_id") @db.Uuid
  assignedAt      DateTime?    @map("assigned_at")
  qualifiedAt     DateTime?    @map("qualified_at")
  wonAt           DateTime?    @map("won_at")
  lostAt          DateTime?    @map("lost_at")
  lostReason      String?      @map("lost_reason")

  // Interest & scoring
  interestType    InterestType?
  budgetMin       Decimal?     @map("budget_min") @db.Decimal(19, 4)
  budgetMax       Decimal?     @map("budget_max") @db.Decimal(19, 4)
  currency        String?      @db.Char(3)
  preferredAreas  String[]     @map("preferred_areas")
  propertyTypes   String[]     @map("property_types")
  bedroomsMin     Int?         @map("bedrooms_min")
  notes           String?
  score           Int          @default(0)
  urgency         String?      // hot, warm, cold

  // Attribution
  utmSource       String?      @map("utm_source")
  utmMedium       String?      @map("utm_medium")
  utmCampaign     String?      @map("utm_campaign")
  utmTerm         String?      @map("utm_term")
  utmContent      String?      @map("utm_content")
  referrerUrl     String?      @map("referrer_url")

  // SLA
  slaDueAt        DateTime?    @map("sla_due_at")
  firstContactedAt DateTime?   @map("first_contacted_at")

  // Raw external data
  externalId      String?      @map("external_id")
  rawPayload      Json?        @map("raw_payload")

  // Conversion
  convertedDealId String?      @map("converted_deal_id") @db.Uuid

  tags            String[]
  metadata        Json?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?     @relation(fields: [branchId], references: [id])
  source         LeadSource? @relation(fields: [sourceId], references: [id])
  contact        Contact?    @relation(fields: [contactId], references: [id])
  assignedTo     User?       @relation("LeadAssignee", fields: [assignedToId], references: [id])
  activities     Activity[]
  assignmentLog  LeadAssignment[]

  @@index([tenantId, status, assignedToId])
  @@index([tenantId, phoneNormalized])
  @@index([tenantId, emailLower])
  @@index([tenantId, nationalId])
  @@index([tenantId, sourceId, createdAt])
  @@index([tenantId, slaDueAt(sort: Asc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("leads")
}

model LeadAssignment {
  id            String   @id @default(uuid()) @db.Uuid
  leadId        String   @map("lead_id") @db.Uuid
  fromUserId    String?  @map("from_user_id") @db.Uuid
  toUserId      String   @map("to_user_id") @db.Uuid
  reason        String?
  ruleId        String?  @map("rule_id") @db.Uuid
  assignedAt    DateTime @default(now()) @map("assigned_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([toUserId, assignedAt])
  @@map("lead_assignments")
}

// =============================================================================
// CONTACT
// =============================================================================

enum ContactType {
  INDIVIDUAL
  COMPANY
}

model Account {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  nameAr      String?  @map("name_ar")
  taxNumber   String?  @map("tax_number")
  industry    String?
  website     String?
  size        String?
  notes       String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts Contact[]

  @@index([tenantId])
  @@map("accounts")
}

model Contact {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  accountId       String?     @map("account_id") @db.Uuid
  type            ContactType @default(INDIVIDUAL)

  // Names (multilingual)
  firstName       String?     @map("first_name")
  lastName        String?     @map("last_name")
  fullName        String      @map("full_name")
  fullNameAr      String?     @map("full_name_ar")
  fullNameNormalized String?  @map("full_name_normalized") // for fuzzy matching

  // Identifiers
  phone           String?
  phoneNormalized String?     @map("phone_normalized")
  phoneSecondary  String?     @map("phone_secondary")
  email           String?
  emailLower      String?     @map("email_lower")
  emailSecondary  String?     @map("email_secondary")
  nationalId      String?     @map("national_id")
  nationalIdType  String?     @map("national_id_type") // SAUDI_ID, EMIRATES_ID, EGYPT_ID, PASSPORT
  nationality     String?     @db.Char(2)

  // Demographics
  dateOfBirth     DateTime?   @map("date_of_birth") @db.Date
  gender          String?
  language        String?     @default("ar")

  // Roles flags (multi-role)
  isBuyer         Boolean     @default(false) @map("is_buyer")
  isSeller        Boolean     @default(false) @map("is_seller")
  isTenant        Boolean     @default(false) @map("is_tenant")
  isLandlord      Boolean     @default(false) @map("is_landlord")
  isInvestor      Boolean     @default(false) @map("is_investor")

  // Communication preferences
  preferredChannel String?    @map("preferred_channel") // whatsapp, email, phone, sms
  doNotContact    Boolean     @default(false) @map("do_not_contact")
  dncReason       String?     @map("dnc_reason")
  marketingConsent Boolean    @default(false) @map("marketing_consent")
  consentAt       DateTime?   @map("consent_at")

  // Address
  city            String?
  district        String?
  address         String?
  country         CountryCode?

  // Financials
  incomeBracket   String?     @map("income_bracket")

  tags            String[]
  metadata        Json?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account     Account?    @relation(fields: [accountId], references: [id])
  leads       Lead[]
  deals       DealParty[]
  activities  Activity[]
  viewings    Viewing[]
  ownedProps  PropertyOwner[]
  receipts     Receipt[]

  @@unique([tenantId, nationalId])
  @@index([tenantId, phoneNormalized])
  @@index([tenantId, emailLower])
  @@index([tenantId, fullNameNormalized])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("contacts")
}

// =============================================================================
// PROPERTY
// =============================================================================

enum PropertyType {
  APARTMENT
  VILLA
  TOWNHOUSE
  PENTHOUSE
  STUDIO
  DUPLEX
  LOFT
  OFFICE
  RETAIL
  WAREHOUSE
  INDUSTRIAL
  SHOWROOM
  CLINIC
  RESTAURANT
  HOTEL_APARTMENT
  COMPOUND
  PLOT
  FARM
  BUILDING_WHOLE
  FLOOR_WHOLE
  LAND_RESIDENTIAL
  LAND_COMMERCIAL
  OTHER
}

enum ListingType {
  SALE
  RENT
  OFF_PLAN_SALE
  RESALE
  SHORT_TERM
  LEASE_TO_OWN
}

enum InventoryStatus {
  DRAFT
  AVAILABLE
  RESERVED
  BOOKED
  SOLD
  RENTED
  CANCELLED
  BLOCKED
  ON_HOLD
  UNDER_MAINTENANCE
}

enum FurnishingStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FURNISHED
}

model MasterProject {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  code            String
  name            String
  nameAr          String?  @map("name_ar")
  description     String?  @db.Text
  descriptionAr   String?  @map("description_ar") @db.Text
  developerName   String?  @map("developer_name")
  city            String?
  district        String?
  country         CountryCode
  totalUnits      Int?     @map("total_units")
  completionDate  DateTime? @map("completion_date") @db.Date
  isOffPlan       Boolean  @default(false) @map("is_off_plan")
  amenities       String[]
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buildings Building[]
  properties Property[]

  @@unique([tenantId, code])
  @@index([tenantId, country, city])
  @@map("master_projects")
}

model Building {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  masterProjectId String   @map("master_project_id") @db.Uuid
  code            String
  name            String
  totalFloors     Int?     @map("total_floors")
  totalUnits      Int?     @map("total_units")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  masterProject MasterProject @relation(fields: [masterProjectId], references: [id], onDelete: Cascade)
  floors        Floor[]
  properties    Property[]

  @@unique([masterProjectId, code])
  @@index([tenantId])
  @@map("buildings")
}

model Floor {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  buildingId String   @map("building_id") @db.Uuid
  number     Int
  name       String?
  totalUnits Int?     @map("total_units")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  building   Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  properties Property[]

  @@unique([buildingId, number])
  @@index([tenantId])
  @@map("floors")
}

model Property {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  masterProjectId String?          @map("master_project_id") @db.Uuid
  buildingId      String?          @map("building_id") @db.Uuid
  floorId         String?          @map("floor_id") @db.Uuid

  // Identification
  referenceCode   String           @map("reference_code") // human-friendly, unique per tenant
  unitNumber      String?          @map("unit_number")

  // Title & description (multilingual)
  titleEn         String?          @map("title_en")
  titleAr         String?          @map("title_ar")
  descriptionEn   String?          @map("description_en") @db.Text
  descriptionAr   String?          @map("description_ar") @db.Text

  // Classification
  propertyType    PropertyType     @map("property_type")
  listingType     ListingType      @map("listing_type")
  inventoryStatus InventoryStatus  @default(DRAFT) @map("inventory_status")

  // Specifications
  bedrooms        Int?
  bathrooms       Int?
  parkingSpots    Int?             @map("parking_spots")
  builtArea       Decimal?         @map("built_area") @db.Decimal(12, 2)
  plotArea        Decimal?         @map("plot_area") @db.Decimal(12, 2)
  areaUnit        String?          @default("sqm") @map("area_unit")
  yearBuilt       Int?             @map("year_built")
  floorNumber     Int?             @map("floor_number")
  furnishing      FurnishingStatus?
  view            String?
  orientation     String?
  amenities       String[]
  features        String[]

  // Pricing
  price           Decimal?         @db.Decimal(19, 4)
  currency        String?          @db.Char(3)
  pricePerArea    Decimal?         @map("price_per_area") @db.Decimal(19, 4)
  rentFrequency   String?          @map("rent_frequency") // annual, monthly, daily
  serviceCharge   Decimal?         @map("service_charge") @db.Decimal(19, 4)
  isPriceVisible  Boolean          @default(true) @map("is_price_visible")

  // Location
  country         CountryCode
  city            String?
  district        String?
  address         String?          @db.Text
  postalCode      String?          @map("postal_code")
  latitude        Decimal?         @db.Decimal(10, 7)
  longitude       Decimal?         @db.Decimal(10, 7)

  // Compliance & permits (free in MVP — store only, no API validation)
  permitNumber    String?          @map("permit_number") // RERA Trakheesi / REGA license
  permitExpiry    DateTime?        @map("permit_expiry")

  // Off-plan & payment plan
  paymentPlanId   String?          @map("payment_plan_id") @db.Uuid

  // Publishing
  isPublished     Boolean          @default(false) @map("is_published")
  publishedAt     DateTime?        @map("published_at")
  expiresAt       DateTime?        @map("expires_at")

  // Tracking
  viewCount       Int              @default(0) @map("view_count")

  // Locking (prevents edits during active deal)
  lockedById      String?          @map("locked_by_id") @db.Uuid
  lockedReason    String?          @map("locked_reason")

  tags            String[]
  metadata        Json?
  createdById     String?          @map("created_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  masterProject MasterProject? @relation(fields: [masterProjectId], references: [id])
  building      Building?      @relation(fields: [buildingId], references: [id])
  floor         Floor?         @relation(fields: [floorId], references: [id])
  paymentPlan   PaymentPlan?   @relation(fields: [paymentPlanId], references: [id])
  media         PropertyMedia[]
  owners        PropertyOwner[]
  dealItems     DealItem[]
  viewings      Viewing[]
  reservations  Reservation[]
  priceHistory  PropertyPriceChange[]

  @@unique([tenantId, referenceCode])
  @@index([tenantId, listingType, inventoryStatus])
  @@index([tenantId, propertyType])
  @@index([tenantId, city, district])
  @@index([tenantId, price, currency])
  @@index([tenantId, bedrooms])
  @@index([masterProjectId, inventoryStatus])
  @@map("properties")
}

model PropertyMedia {
