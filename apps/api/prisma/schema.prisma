// =============================================================================
// BOOKING — formal commitment to purchase (off-plan & secondary market)
//
// The booking lifecycle in MENA real estate sits between a soft `Reservation`
// (a 24-72h hold) and a closed `Deal`. The buyer pays a non-refundable (or
// refundable within cooling-off) booking fee, the unit is taken off market,
// and a Sale-Purchase Agreement (SPA) must be signed within `spaDueAt` or
// the booking is auto-expired and the unit is released.
// =============================================================================

enum BookingStatus {
  PENDING_PAYMENT       // Booking created, awaiting fee receipt
  ACTIVE                // Fee received, awaiting SPA signature
  CONVERTED_TO_SALE     // SPA signed → deal closed
  CANCELLED             // Buyer cancelled within cooling-off (refund issued)
  EXPIRED               // SPA deadline missed, auto-released
  FORFEITED             // Buyer abandoned after cooling-off (fee forfeited)
}

enum BookingPaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CREDIT_CARD
  ONLINE_GATEWAY
  OTHER
}

model Booking {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid

  // Sequential per-tenant identifier (e.g., BK-2026-000123) for human reference
  bookingNumber     String   @map("booking_number")

  // What & for whom
  propertyId        String   @map("property_id") @db.Uuid
  contactId         String   @map("contact_id") @db.Uuid
  agentId           String   @map("agent_id") @db.Uuid       // selling agent
  branchId          String?  @map("branch_id") @db.Uuid
  leadId            String?  @map("lead_id") @db.Uuid        // originating lead
  dealId            String?  @map("deal_id") @db.Uuid        // populated once converted

  // Commercial terms
  unitPrice         Decimal  @map("unit_price") @db.Decimal(19, 4)
  bookingFee        Decimal  @map("booking_fee") @db.Decimal(19, 4)
  currency          String   @db.Char(3)
  paymentPlanId     String?  @map("payment_plan_id") @db.Uuid

  // Lifecycle
  status            BookingStatus @default(PENDING_PAYMENT)
  bookedAt          DateTime  @default(now()) @map("booked_at")
  feeReceivedAt     DateTime? @map("fee_received_at")
  paymentMethod     BookingPaymentMethod? @map("payment_method")
  paymentReference  String?   @map("payment_reference")

  // Deadlines (auto-enforced by cron)
  paymentDueAt      DateTime  @map("payment_due_at")   // by when the fee must arrive
  spaDueAt          DateTime  @map("spa_due_at")       // SPA must be signed by this date
  coolingOffEndsAt  DateTime? @map("cooling_off_ends_at") // until this date, full refund possible

  // SPA & closing
  spaSignedAt       DateTime? @map("spa_signed_at")
  cancelledAt       DateTime? @map("cancelled_at")
  cancellationReason String?  @map("cancellation_reason")
  refundAmount      Decimal?  @map("refund_amount") @db.Decimal(19, 4)
  refundedAt        DateTime? @map("refunded_at")
  forfeitedAt       DateTime? @map("forfeited_at")
  expiredAt         DateTime? @map("expired_at")

  // Audit
  createdById       String?  @map("created_by_id") @db.Uuid
  notes             String?  @db.Text
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, bookingNumber])
  @@index([tenantId, status, spaDueAt])
  @@index([tenantId, propertyId])
  @@index([tenantId, contactId])
  @@index([tenantId, agentId, status])
  @@index([status, paymentDueAt])  // for auto-expiry job
  @@index([status, spaDueAt])      // for auto-expiry job
  @@map("bookings")
}

// =============================================================================
// ACCOUNTING FOUNDATION � double-entry, exact decimal, idempotent posting
// =============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model ChartOfAccount {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  code        String     @map("code")
  name        String     @map("name")
  type        AccountType
  parentId    String?    @map("parent_id") @db.Uuid
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent ChartOfAccount? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children ChartOfAccount[] @relation("AccountHierarchy")
  journalLines JournalEntryLine[]
  @@unique([tenantId, code])
  @@index([tenantId, type, isActive])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  journalNo   String     @map("journal_no")
  entryDate   DateTime   @map("entry_date")
  description String?    @map("description")
  sourceType  String?    @map("source_type")
  sourceId    String?    @map("source_id")
  isPosted    Boolean    @default(false) @map("is_posted")
  postedAt    DateTime?  @map("posted_at")
  createdById String?    @map("created_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines JournalEntryLine[]
  @@unique([tenantId, journalNo])
  @@index([tenantId, isPosted, entryDate])
  @@map("journal_entries")
}

model JournalEntryLine {
  id            String         @id @default(uuid()) @db.Uuid
  journalEntryId String        @map("journal_entry_id") @db.Uuid
  accountId     String         @map("account_id") @db.Uuid
  debit         Decimal        @db.Decimal(19, 4) @default(0)
  credit        Decimal        @db.Decimal(19, 4) @default(0)
  description   String?        @map("description")
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id])
  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

model Receipt {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  receiptNo       String     @map("receipt_no")
  contactId       String     @map("contact_id") @db.Uuid
  amount          Decimal    @db.Decimal(19, 4)
  currency        String     @db.Char(3)
  paymentMethod   String     @map("payment_method")
  referenceNo     String?    @map("reference_no")
  receivedAt      DateTime   @map("received_at")
  isReversed      Boolean    @default(false) @map("is_reversed")
  reversedAt      DateTime?  @map("reversed_at")
  createdById     String?    @map("created_by_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact @relation(fields: [contactId], references: [id])
  allocations CollectionAllocation[]
  @@unique([tenantId, receiptNo])
  @@map("receipts")
}

model CollectionAllocation {
  id            String    @id @default(uuid()) @db.Uuid
  receiptId     String    @map("receipt_id") @db.Uuid
  installmentId String    @map("installment_id") @db.Uuid
  amount        Decimal   @db.Decimal(19, 4)
  allocatedAt   DateTime  @default(now()) @map("allocated_at")
  receipt      Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  @@index([receiptId])
  @@map("collection_allocations")
}




