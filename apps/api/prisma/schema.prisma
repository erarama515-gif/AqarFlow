  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([propertyId, contactId])
  @@map("property_owners")
}

model PropertyPriceChange {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  oldPrice   Decimal? @map("old_price") @db.Decimal(19, 4)
  newPrice   Decimal  @map("new_price") @db.Decimal(19, 4)
  currency   String   @db.Char(3)
  reason     String?
  changedById String? @map("changed_by_id") @db.Uuid
  changedAt  DateTime @default(now()) @map("changed_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, changedAt(sort: Desc)])
  @@map("property_price_changes")
}

model Reservation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  contactId   String?  @map("contact_id") @db.Uuid
  leadId      String?  @map("lead_id") @db.Uuid
  dealId      String?  @map("deal_id") @db.Uuid
  reservedById String  @map("reserved_by_id") @db.Uuid
  status      String   @default("ACTIVE") // ACTIVE, CONVERTED, CANCELLED, EXPIRED
  amount      Decimal? @db.Decimal(19, 4)
  currency    String?  @db.Char(3)
  expiresAt   DateTime @map("expires_at")
  cancelledAt DateTime? @map("cancelled_at")
  cancelReason String?  @map("cancel_reason")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, expiresAt])
  @@index([propertyId, status])
  @@map("reservations")
}

model PaymentPlan {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  isTemplate  Boolean  @default(false) @map("is_template")
  downPaymentPct Decimal? @map("down_payment_pct") @db.Decimal(5, 2)
  postHandoverYears Int? @map("post_handover_years")
  installments Json    // [{ name, type, pct/amount, milestone/daysOffset, dueDate }]
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([tenantId, isTemplate])
  @@map("payment_plans")
}

// =============================================================================
// DEAL
// =============================================================================

enum DealStatus {
  OPEN
  WON
  LOST
  CANCELLED
  ON_HOLD
}

enum DealPartyRole {
  BUYER
  SELLER
  TENANT
  LANDLORD
  CO_AGENT
  REFERRER
  MORTGAGE_ADVISOR
}

model Pipeline {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  pipelineType String  @default("SALE") @map("pipeline_type") // SALE, RENTAL, OFF_PLAN
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  deals  Deal[]

  @@unique([tenantId, code])
  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid()) @db.Uuid
  pipelineId  String   @map("pipeline_id") @db.Uuid
  code        String
  name        String
  sortOrder   Int      @map("sort_order")
  probability Int      @default(0) // 0-100
  isWon       Boolean  @default(false) @map("is_won")
  isLost      Boolean  @default(false) @map("is_lost")
  createdAt   DateTime @default(now()) @map("created_at")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, code])
  @@index([pipelineId, sortOrder])
  @@map("pipeline_stages")
}

model Deal {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  branchId        String?    @map("branch_id") @db.Uuid
  pipelineId      String     @map("pipeline_id") @db.Uuid
  stageId         String     @map("stage_id") @db.Uuid
  ownerId         String     @map("owner_id") @db.Uuid

  referenceCode   String     @map("reference_code")
  title           String
  status          DealStatus @default(OPEN)
  amount          Decimal?   @db.Decimal(19, 4)
  currency        String?    @db.Char(3)
  probability     Int        @default(0)
  expectedCloseAt DateTime?  @map("expected_close_at")
  closedAt        DateTime?  @map("closed_at")
  wonAt           DateTime?  @map("won_at")
  lostAt          DateTime?  @map("lost_at")
  lostReason      String?    @map("lost_reason")

  sourceLeadId    String?    @map("source_lead_id") @db.Uuid

  tags            String[]
  metadata        Json?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?           @relation(fields: [branchId], references: [id])
  pipeline       Pipeline          @relation(fields: [pipelineId], references: [id])
  stage          PipelineStage     @relation(fields: [stageId], references: [id])
  owner          User              @relation("DealOwner", fields: [ownerId], references: [id])
  parties        DealParty[]
  items          DealItem[]
  stageHistory   DealStageHistory[]
  commissionEntries CommissionEntry[]
  activities     Activity[]

  @@unique([tenantId, referenceCode])
  @@index([tenantId, status, stageId])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, expectedCloseAt])
  @@map("deals")
}

model DealParty {
  id        String        @id @default(uuid()) @db.Uuid
  dealId    String        @map("deal_id") @db.Uuid
  contactId String        @map("contact_id") @db.Uuid
  role      DealPartyRole
  sharePct  Decimal?      @map("share_pct") @db.Decimal(5, 2)
  createdAt DateTime      @default(now()) @map("created_at")

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id])

  @@unique([dealId, contactId, role])
  @@map("deal_parties")
}

model DealItem {
  id         String   @id @default(uuid()) @db.Uuid
  dealId     String   @map("deal_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  amount     Decimal? @db.Decimal(19, 4)
  currency   String?  @db.Char(3)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  deal     Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id])

  @@unique([dealId, propertyId])
  @@map("deal_items")
}

model DealStageHistory {
  id          String   @id @default(uuid()) @db.Uuid
  dealId      String   @map("deal_id") @db.Uuid
  fromStageId String?  @map("from_stage_id") @db.Uuid
  toStageId   String   @map("to_stage_id") @db.Uuid
  changedById String?  @map("changed_by_id") @db.Uuid
  notes       String?
  changedAt   DateTime @default(now()) @map("changed_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, changedAt(sort: Desc)])
  @@map("deal_stage_history")
}

// =============================================================================
// ACTIVITY & CALENDAR
// =============================================================================

enum ActivityType {
  CALL
  MEETING
  EMAIL
  WHATSAPP
  SMS
  NOTE
  TASK
  VIEWING
}

enum ActivityStatus {
  PLANNED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ViewingStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

model Activity {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  type        ActivityType
  status      ActivityStatus @default(PLANNED)
  subject     String
  description String?        @db.Text
  scheduledAt DateTime?      @map("scheduled_at")
  completedAt DateTime?      @map("completed_at")
  durationMin Int?           @map("duration_min")

  // Polymorphic links
  leadId      String?        @map("lead_id") @db.Uuid
  contactId   String?        @map("contact_id") @db.Uuid
  dealId      String?        @map("deal_id") @db.Uuid
  propertyId  String?        @map("property_id") @db.Uuid

  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])
  lead    Lead?    @relation(fields: [leadId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id])

  @@index([tenantId, userId, scheduledAt])
  @@index([tenantId, type, status])
  @@index([leadId, createdAt(sort: Desc)])
  @@index([contactId, createdAt(sort: Desc)])
  @@index([dealId, createdAt(sort: Desc)])
  @@map("activities")
}

model Viewing {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  propertyId    String        @map("property_id") @db.Uuid
  contactId     String        @map("contact_id") @db.Uuid
  agentId       String        @map("agent_id") @db.Uuid
  scheduledAt   DateTime      @map("scheduled_at")
  durationMin   Int           @default(60) @map("duration_min")
  status        ViewingStatus @default(SCHEDULED)
  confirmedAt   DateTime?     @map("confirmed_at")
  completedAt   DateTime?     @map("completed_at")
  cancelledAt   DateTime?     @map("cancelled_at")
  cancelReason  String?       @map("cancel_reason")
  feedback      String?       @db.Text
  rating        Int?          // 1-5
  notes         String?
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id])
  contact  Contact  @relation(fields: [contactId], references: [id])

  @@index([tenantId, agentId, scheduledAt])
  @@index([propertyId, scheduledAt])
  @@map("viewings")
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  assigneeId  String?   @map("assignee_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  title       String
  description String?   @db.Text
  dueAt       DateTime? @map("due_at")
  priority    String?   // low, medium, high, urgent
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, DONE, CANCELLED
  completedAt DateTime? @map("completed_at")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, assigneeId, status])
  @@index([tenantId, dueAt])
  @@map("tasks")
}

// =============================================================================
// COMMISSION
// =============================================================================

enum CommissionStatus {
  PENDING_CALCULATION
  CALCULATED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  CLAWED_BACK
}

model CommissionRule {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  code          String
  name          String
  description   String?
  isActive      Boolean  @default(true) @map("is_active")
  priority      Int      @default(0)
  conditions    Json     // { propertyType, listingType, minAmount, maxAmount, ... }
  calculation   Json     // { type: 'percentage'|'fixed'|'tiered', value, tiers }
  splits        Json     // [{ role: 'PRIMARY_AGENT', pct: 50, recipientType: 'AGENT' }, ...]
  vatRate       Decimal? @map("vat_rate") @db.Decimal(5, 2)
  clawbackDays  Int?     @map("clawback_days")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries CommissionEntry[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive, priority])
  @@map("commission_rules")
}

model CommissionEntry {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  dealId          String           @map("deal_id") @db.Uuid
  ruleId          String?          @map("rule_id") @db.Uuid
  recipientUserId String?          @map("recipient_user_id") @db.Uuid
  recipientContactId String?       @map("recipient_contact_id") @db.Uuid
  recipientRole   String           @map("recipient_role") // PRIMARY_AGENT, CO_AGENT, REFERRER, BROKERAGE, MANAGER_OVERRIDE
  baseAmount      Decimal          @map("base_amount") @db.Decimal(19, 4)
  sharePct        Decimal          @map("share_pct") @db.Decimal(7, 4)
  grossAmount     Decimal          @map("gross_amount") @db.Decimal(19, 4)
  vatRate         Decimal          @map("vat_rate") @db.Decimal(5, 2) @default(0)
  vatAmount       Decimal          @map("vat_amount") @db.Decimal(19, 4) @default(0)
  netAmount       Decimal          @map("net_amount") @db.Decimal(19, 4)
  currency        String           @db.Char(3)
  status          CommissionStatus @default(PENDING_CALCULATION)
  calculationLog  Json?            @map("calculation_log")
  approvedById    String?          @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?        @map("approved_at")
  paidAt          DateTime?        @map("paid_at")
  paymentMethod   String?          @map("payment_method")
  paymentRef      String?          @map("payment_ref")
  clawbackExpiresAt DateTime?      @map("clawback_expires_at")
  clawedBackAt    DateTime?        @map("clawed_back_at")
  notes           String?
  metadata        Json?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal      Deal            @relation(fields: [dealId], references: [id])
  rule      CommissionRule? @relation(fields: [ruleId], references: [id])
  recipient User?           @relation("CommissionRecipient", fields: [recipientUserId], references: [id])

  @@index([tenantId, recipientUserId, status])
  @@index([tenantId, dealId])
  @@index([tenantId, status, createdAt])
  @@map("commission_entries")
}

// =============================================================================
// NOTIFICATION
// =============================================================================

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
  PUSH
  WEBHOOK
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model EmailTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  subject   String
  bodyHtml  String   @map("body_html") @db.Text
  bodyText  String?  @map("body_text") @db.Text
  language  String   @default("ar")
  variables String[] // available merge tags
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code, language])
  @@map("email_templates")
}

model Notification {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  type        String               // e.g., 'lead.assigned', 'deal.won'
  channel     NotificationChannel
  priority    NotificationPriority @default(NORMAL)
  title       String
  body        String               @db.Text
  link        String?
  metadata    Json?
  readAt      DateTime?            @map("read_at")
  sentAt      DateTime?            @map("sent_at")
  deliveredAt DateTime?            @map("delivered_at")
  failedAt    DateTime?            @map("failed_at")
  failureReason String?            @map("failure_reason")
  createdAt   DateTime             @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt, createdAt(sort: Desc)])
  @@index([tenantId, type])
  @@map("notifications")
}

// =============================================================================
// AUDIT & SHARED
// =============================================================================

model AuditLog {
